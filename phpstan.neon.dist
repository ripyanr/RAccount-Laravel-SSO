includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
        - tests

    # The package ships its config from src/config (merged into the host app by
    # the service provider), so env() calls there are legitimate and the config
    # parser should read those files.
    configDirectories:
        - src/config

    ignoreErrors:
        # The default user model refers to the consuming application's class
        # and never exists inside this package.
        -
            message: '#Class App\\Models\\User not found\.#'
            path: src/config/raccount-sso.php

        # Pest binds test closures to the TestCase at runtime, but without the
        # Pest PHPStan plugin `$this` inside an `it(...)` closure is resolved
        # against the surrounding PendingCalls\TestCall.
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::fail\(\)#'
            path: tests/Feature/ClientTest.php
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::fail\(\)#'
            path: tests/Feature/TokenServiceTest.php

        # The morph target of RaccountAccount::user() is defined by the
        # consuming application, so the primary key of `$account->user` cannot
        # be resolved statically. The fixture user always has an auto-increment
        # id column.
        -
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$id\.#'
            path: tests/Feature/ModelsTest.php
        -
            message: '#Unable to resolve the template type TAndValue in call to method Pest\\Expectation<Illuminate\\Database\\Eloquent\\Model\|null>::and\(\)#'
            path: tests/Feature/ModelsTest.php

        # The resolver contract intentionally returns the generic
        # Authenticatable interface, so the fixture user's columns cannot be
        # resolved statically. The ternary comes verbatim from the task brief
        # ($resolved is always truthy once resolve() has returned).
        -
            message: '#Access to an undefined property Illuminate\\Contracts\\Auth\\Authenticatable::\$(id|name|email)\.#'
            path: tests/Feature/ResolverTest.php
        -
            message: '#Unable to resolve the template type TValue in call to function expect#'
            path: tests/Feature/ResolverTest.php
        -
            message: '#Unable to resolve the template type TAndValue in call to method Pest\\Expectation<.+>::and\(\)#'
            path: tests/Feature/ResolverTest.php
        -
            message: '#Ternary operator condition is always true\.#'
            path: tests/Feature/ResolverTest.php

        # FlowTest comes verbatim from the task brief. Pest binds test closures
        # to the TestCase at runtime (same false positive as above), and
        # `Auth::user()` statically resolves to the generic foundation User
        # whose columns the fixture migration only creates at runtime.
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::(get|actingAs)\(\)#'
            path: tests/Feature/FlowTest.php
        -
            message: '#Access to an undefined property Illuminate\\Foundation\\Auth\\User::\$email\.#'
            path: tests/Feature/FlowTest.php
        -
            message: '#Unable to resolve the template type TAndValue in call to method Pest\\Expectation<bool\|null>::and\(\)#'
            path: tests/Feature/FlowTest.php

        # MiddlewareTest comes verbatim from the task brief. Pest binds test
        # closures to the TestCase at runtime (same false positive as above).
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::(get|actingAs)\(\)#'
            path: tests/Feature/MiddlewareTest.php

        # CommandsTest comes verbatim from the task brief. Pest binds test
        # closures to the TestCase at runtime (same false positive as above);
        # artisan() resolves against the bound TestCase when Pest executes.
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::artisan\(\)#'
            path: tests/Feature/CommandsTest.php

        # The occurred_at guard comes verbatim from the task brief. PHPStan
        # narrows `mixed` to exclude null after isset(), so the defensive null
        # check against the untyped JSON payload is reported as always true.
        -
            message: '#Strict comparison using \!== between mixed and null will always evaluate to true\.#'
            path: src/Webhooks/WebhookPayload.php

        # WebhookTest comes verbatim from the task brief. Pest's test() helper
        # statically resolves to TestCall|HigherOrderTapProxy (same class of
        # false positive as the closure-binding ignores above), the helper
        # keeps the brief's untyped array signatures, and the fixture user's
        # columns only exist at runtime.
        -
            message: '#Function postWebhook\(\) (has parameter \$\w+ with no value type specified in iterable type array|return type with generic class Illuminate\\Testing\\TestResponse does not specify its types: TResponse)#'
            path: tests/Feature/WebhookTest.php
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall\|Pest\\Support\\HigherOrderTapProxy::(transformHeadersToServerVars|call)\(\)#'
            path: tests/Feature/WebhookTest.php
        -
            message: '#Access to an undefined property Raccount\\Sso\\Tests\\Fixtures\\User::\$name\.#'
            path: tests/Feature/WebhookTest.php
        -
            message: '#Unable to resolve the template type TValue in call to function expect#'
            path: tests/Feature/WebhookTest.php

        # DirectoryTest comes verbatim from the task brief; the
        # directoryRecord() helper keeps the brief's untyped array signature
        # (same class of false positive as postWebhook() above).
        -
            message: '#Function directoryRecord\(\) return type has no value type specified in iterable type array\.#'
            path: tests/Feature/DirectoryTest.php

