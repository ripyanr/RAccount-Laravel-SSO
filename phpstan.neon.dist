includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
        - tests

    # The package ships its config from src/config (merged into the host app by
    # the service provider), so env() calls there are legitimate and the config
    # parser should read those files.
    configDirectories:
        - src/config

    ignoreErrors:
        # The default user model refers to the consuming application's class
        # and never exists inside this package.
        -
            message: '#Class App\\Models\\User not found\.#'
            path: src/config/raccount-sso.php

        # The default resolver class is introduced by a later task; drop this
        # ignore once Raccount\Sso\Resolvers\DefaultUserResolver exists.
        -
            message: '#Class Raccount\\Sso\\Resolvers\\DefaultUserResolver not found\.#'
            path: src/config/raccount-sso.php

        # Pest binds test closures to the TestCase at runtime, but without the
        # Pest PHPStan plugin `$this` inside an `it(...)` closure is resolved
        # against the surrounding PendingCalls\TestCall.
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::fail\(\)#'
            path: tests/Feature/ClientTest.php

        # The morph target of RaccountAccount::user() is defined by the
        # consuming application, so the primary key of `$account->user` cannot
        # be resolved statically. The fixture user always has an auto-increment
        # id column.
        -
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$id\.#'
            path: tests/Feature/ModelsTest.php
        -
            message: '#Unable to resolve the template type TAndValue in call to method Pest\\Expectation<Illuminate\\Database\\Eloquent\\Model\|null>::and\(\)#'
            path: tests/Feature/ModelsTest.php
